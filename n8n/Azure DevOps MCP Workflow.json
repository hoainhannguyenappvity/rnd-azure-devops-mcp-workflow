      ],
      "id": "e84722e1-a848-45b4-a1a6-177a2bdac338",
      "name": "Map Path Git"
    },
    {
      "parameters": {
        "jsCode": "const value = $input.first().json.stdout.split(\"\\n\");\n\nconst valueMap = value.map(v => JSON.parse(v))\n\nlet agent_message = valueMap.find(i => i?.item?.type === 'agent_message')\n\nreturn { agent_message}\n  "
      },
