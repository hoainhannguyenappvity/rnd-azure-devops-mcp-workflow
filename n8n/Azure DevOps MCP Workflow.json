    {
      "parameters": {
        "jsCode": "const sourceRefName = $('Webhook').first().json.body.resource.sourceRefName;\nconst targetRefName = $('Webhook').first().json.body.resource.targetRefName;\n\n// 1. Định nghĩa các tiền tố dưới dạng biến\nconst OLD_PREFIX = \"refs/heads/\";\nconst NEW_PREFIX = \"origin/\";\n\n// 2. Tách riêng phần tên Branch (loại bỏ refs/heads/)\nconst sourceBranchPath = sourceRefName.replace(OLD_PREFIX, \"\"); // Kết quả: \"POV/dev_RnD\"\nconst targetBranchPath = targetRefName.replace(OLD_PREFIX, \"\"); // Kết quả: \"POV/master\"\n\n// 3. Ghép lại với tiền tố mới\nconst result = {\n  sourceRefName: `${NEW_PREFIX}${sourceBranchPath}`,\n  targetRefName: `${NEW_PREFIX}${targetBranchPath}`\n};\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
